{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Appztore — enables core, event emission, and HTTP fetch",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging",
    "core:app:allow-version",
    "core:app:allow-name",
    "http:default",
    "http:allow-fetch"
  ]
}
